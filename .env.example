# Copy this file to ".env" (not committed to git) and adjust for your machine.
# In production (PythonAnywhere), you'll set these as real environment
# variables in the WSGI config file instead of using a .env file.

DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email (only needed for real "Forgot password" emails) -----------------
# Leave these out entirely (or delete this whole section) to keep using the
# console backend, which just prints emails to the terminal instead of
# sending them — fine for local testing.
#
# Example values below are for Gmail. DJANGO_EMAIL_HOST_PASSWORD must be a
# 16-character Google "App Password" (myaccount.google.com/apppasswords) —
# NOT your normal Gmail password, Gmail rejects that for this.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=youraddress@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=your16characterapppassword
DJANGO_DEFAULT_FROM_EMAIL=youraddress@gmail.com
